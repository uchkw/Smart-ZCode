ZCODE_URL=http://127.0.0.1:33113/
ZCODE_TOKEN=replace-with-your-zcode-token
SMART_HOST=127.0.0.1
SMART_PORT=33114
# HTTPS URL used by your phone (optional; enables strict Origin checking)
# SMART_PUBLIC_ORIGIN=https://your-machine.your-tailnet.ts.net
# Optional contact address; defaults to SMART_PUBLIC_ORIGIN when omitted.
# Use your actual email address. Apple Push rejects localhost placeholders.
# VAPID_SUBJECT=mailto:admin@your-domain.example
